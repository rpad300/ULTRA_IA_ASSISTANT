{
    "name": "ultra-assistant-monorepo",
    "version": "0.1.0",
    "description": "Ultra AI Assistant Desktop OS",
    "main": "dist/electron/main.js",
    "scripts": {
        "start": "electron .",
        "dev:frontend": "cd src/frontend && npm run dev",
        "dev:electron": "tsc -p src/electron && electron .",
        "build:electron": "tsc -p src/electron && node -e \"require('fs').copyFileSync('src/electron/wasapi_capture.py', 'dist/electron/wasapi_capture.py')\"",
        "dev:backend": "cd src/backend && uvicorn main:app --reload --port 8000",
        "setup:backend": "cd src/backend && pip install -r requirements.txt",
        "setup": "powershell -ExecutionPolicy Bypass -File ./setup.ps1",
        "setup:all": "npm run setup",
        "start:dev": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
        "build:native": "cd src/electron/native && npm install && node-gyp rebuild",
        "rebuild:electron": "electron-rebuild -f -w wasapi_capture",
        "install:vs-components": "powershell -ExecutionPolicy Bypass -File ./scripts/install-windows-sdk.ps1"
    },
    "keywords": [],
    "author": "Antigravity",
    "license": "ISC",
    "devDependencies": {
        "concurrently": "^8.0.0",
        "electron": "^28.0.0",
        "electron-rebuild": "^3.2.9",
        "electron-squirrel-startup": "^1.0.0",
        "node-addon-api": "^7.1.1",
        "node-gyp": "^10.3.1",
        "typescript": "^5.0.0"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.1.11",
        "@radix-ui/react-slot": "^1.2.4",
        "@radix-ui/react-switch": "^1.2.6",
        "@radix-ui/react-tabs": "^1.1.13",
        "ws": "^8.16.0"
    }
}
